# Database Configuration
spring.datasource.url=jdbc:postgresql://localhost:5432/pet_booklet_db
spring.datasource.username=your_db_username
spring.datasource.password=your_db_password

# JPA / Hibernate Settings
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true

# JWT Configuration (Must be at least 256 bits / 32 characters for HS256)
jwt.secret=YourSuperSecretKeyForPetBookletAppMustBeLongEnoughThatIsAtLeast256Bits